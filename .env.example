# ローカル開発用の設定例。
# このファイルを .env にコピーして使う（.env は .gitignore で除外している）。
#
# 実際の値をこのファイルに書かないこと。ここに置いてよいのは
# 「どの変数が必要か」という情報だけである。

# --- データベース ---
DB_NAME=tabilog
DB_USER=tabilog
DB_PASSWORD=change_me_local_only
MYSQL_ROOT_PASSWORD=change_me_root_local_only

# --- アプリケーション ---
# local / production
APP_ENV=local
# debug / info / warn / error
LOG_LEVEL=debug

# --- 認証 ---
# 32文字以上。本番は SSM Parameter Store の SecureString から注入する
JWT_SECRET=change_me_at_least_32_characters_long_local_only
# 本番（HTTPS）では true にする
COOKIE_SECURE=false
# ALB / CloudFront の背後では true にする。
# false のままだと発信元が全てロードバランサになり、レート制限が機能しない
TRUST_PROXY_HEADERS=false
