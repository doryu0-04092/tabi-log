# ローカル開発用の設定例。
# このファイルを .env にコピーして使う（.env は .gitignore で除外している）。
#
# 実際の値をこのファイルに書かないこと。ここに置いてよいのは
# 「どの変数が必要か」という情報だけである。

# --- データベース ---
DB_NAME=tabilog
DB_USER=tabilog
DB_PASSWORD=change_me_local_only
MYSQL_ROOT_PASSWORD=change_me_root_local_only

# --- アプリケーション ---
# local / production
APP_ENV=local
# debug / info / warn / error
LOG_LEVEL=debug
