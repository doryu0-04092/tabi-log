# ローカル開発用の設定例。
# このファイルを .env にコピーして使う（.env は .gitignore で除外している）。
#
# 実際の値をこのファイルに書かないこと。ここに置いてよいのは
# 「どの変数が必要か」という情報だけである。

# --- データベース ---
DB_NAME=tabilog
DB_USER=tabilog
DB_PASSWORD=change_me_local_only
MYSQL_ROOT_PASSWORD=change_me_root_local_only

# --- アプリケーション ---
# local / production
APP_ENV=local
# debug / info / warn / error
LOG_LEVEL=debug

# --- 認証 ---
# 32文字以上。本番は SSM Parameter Store の SecureString から注入する
JWT_SECRET=change_me_at_least_32_characters_long_local_only
# 本番（HTTPS）では true にする
COOKIE_SECURE=false
# ALB / CloudFront の背後では true にする。
# false のままだと発信元が全てロードバランサになり、レート制限が機能しない
TRUST_PROXY_HEADERS=false

# ログイン・登録の試行上限（同一IP / 同一アカウントごと、5分間）。
# **本番は既定の 10 を使う。** ローカルと CI では E2E が
# 短時間に何度も登録するため上限に達してしまうので引き上げる。
# 上限そのものの動作は backend の単体テストで担保している。
#
# **E2E が増えるたびに足りなくなる。** 1回の実行で作る利用者は
# テスト数とほぼ同数で、失敗時の再試行でさらに増える。
# 2026-08-29 に 200 では足りなくなり（設定画面の13件を足した時点で 429）、
# 余裕を持たせて引き上げた。
LOGIN_ATTEMPT_LIMIT=2000

# 投稿とコメントの作成にかける上限（既定は 1時間に 20件 / 60件）。
#
# **ログイン試行の上限と同じ理由で、ここでも緩めている。**
# 無限スクロールの E2E は1人で21件の投稿を作るため、
# 既定の 20 では検証したいものと関係のないところで 429 になる。
# **本番では既定のままにする**（環境変数を設定しない）。
POST_CREATE_LIMIT=2000
COMMENT_CREATE_LIMIT=2000

# 署名付き URL の発行回数の上限（既定 120/時）。
# **投稿の上限では止まらない経路である。** 発行1回ごとに S3 の PUT・
# Lambda の起動・行の追加が起きるため、投稿を作らずに資源を消費できる。
UPLOAD_LIMIT=2000

# --- 画像の配信（CloudFront） ---
#
# **ローカルでは空のままにする。** LocalStack に CloudFront は無い。
# 空なら今までどおり S3 の署名付き URL で配る。
#
# AWS 上では Terraform がこの3つをタスク定義に注入する。
# **3つとも揃っていないと起動時に落ちる**（一部だけ設定された状態で
# 黙って S3 に落ちると、CDN にしたつもりが効いていないことに気づけない）。
#
# CDN_DOMAIN=
# CDN_KEY_PAIR_ID=
# CDN_PRIVATE_KEY=

# --- 画像の保存先 ---
STORAGE_S3_BUCKET=tabilog-media
