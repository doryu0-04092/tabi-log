# このファイルを terraform.tfvars に写して、自分の値を入れる。
# terraform.tfvars は .gitignore で除外している。

# **S3 のバケット名は全 AWS アカウントで一意である。**
# 他の人と衝突しない名前にすること。
images_bucket_name = "tabilog-media-CHANGE-ME"
static_bucket_name = "tabilog-static-CHANGE-ME"

# 以下は既定値がある。変えたいときだけ書く。
#
# region        = "ap-northeast-1"
# task_cpu      = 512
# task_memory   = 1024
# desired_count = 2
#
# **image_tag は latest にしない。** どの版が動いているか分からなくなる。
# image_tag = "initial"

# アラームの通知先メールアドレス。
#
# **空なら通知しない。** アラーム自体は作られるが送り先が無く、
# 鳴っている事実はコンソールと API からしか見えない。
#
# 値を入れて apply すると AWS から購読の確認メールが届く。
# **承認するまで通知は来ない。**
alert_email = "you@example.com"
