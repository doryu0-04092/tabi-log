# syntax=docker/dockerfile:1

# ---- ビルド段 ----
FROM golang:1.27-alpine AS build

WORKDIR /src
COPY backend/ ./

# CGO を無効にして静的リンクする。実行段の alpine に共有ライブラリを持ち込まずに済む。
# -trimpath はビルド環境の絶対パスを成果物から除く。
ENV CGO_ENABLED=0 GOOS=linux

# `go mod download` を別の層で先に実行しない。
#
# go.mod にはコード生成ツール（sqlc / oapi-codegen）が tool 依存として入っており、
# `go mod download` は**それらが引き込む 141 モジュール（grpc・protobuf 等）まで
# すべて取得する**。サーバーのビルドに実際に必要な外部モジュールは 2 個だけで、
# 残りは実行イメージに一切関係しない。
#
# 取得量が多いほどネットワーク起因の失敗に当たりやすく、実際に CI の
# Docker ビルドが proxy.golang.org からの取得中断で落ちている。
#
# `go build ./cmd/server` は import グラフに含まれるモジュールだけを取得するため、
# 取得対象が 141 から 2 に減る。層の分割で得られたキャッシュ効果は、
# BuildKit のキャッシュマウントで置き換える。
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -trimpath -ldflags="-s -w" -o /out/server ./cmd/server

# ---- 実行段 ----
FROM alpine:3.24

# ヘルスチェックや証明書検証に必要な最小限のみ入れる。
RUN apk add --no-cache ca-certificates tzdata \
    && adduser -D -u 10001 app

COPY --from=build /out/server /usr/local/bin/server

# root で動かさない。コンテナが侵害された場合の影響を狭める。
USER app

EXPOSE 8080

# ヘルスチェックは DB を見ない livez に向ける。
# readyz を使うと、DB の一時的な不調でコンテナ自体が unhealthy と判定される。
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/api/livez || exit 1

ENTRYPOINT ["/usr/local/bin/server"]
